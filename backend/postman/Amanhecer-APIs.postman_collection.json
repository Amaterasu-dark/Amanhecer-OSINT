{
  "info": {
    "name": "Amanhecer — APIs públicas e legado",
    "description": "Importe também Amanhecer.postman_environment.json e selecione o ambiente. Preencha as variáveis das consultas. Requisições espelham o código atual; não foram enviadas. Não há scripts nem testes automatizados. Chamadas diretas aos serviços externos: o backend é uma CLI, não um servidor REST. Desative o seguimento de redirecionamentos no cliente e use timeout de 15000 ms para aproximar o transporte do programa. Prefira enviar individualmente; não há limitação automática de frequência nesta collection. A API devolve a resposta bruta, sem mascaramento ou seleção de campos feitos pela CLI.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "protocolProfileBehavior": {
    "followRedirects": false
  },
  "item": [
    {
      "name": "01 — GitHub (ativo)",
      "item": [
        {
          "name": "Arroba exato",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github+json"
              },
              {
                "key": "User-Agent",
                "value": "AmanhecerOSINT/0.2.0"
              },
              {
                "key": "X-GitHub-Api-Version",
                "value": "2026-03-10"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "https://api.github.com/users/{{github_username}}",
              "protocol": "https",
              "host": [
                "api",
                "github",
                "com"
              ],
              "path": [
                "users",
                "{{github_username}}"
              ],
              "query": []
            },
            "description": "Informe somente o arroba, sem @. 404 indica perfil não encontrado nesta fonte; bloqueios e limites são inconclusivos."
          },
          "response": []
        },
        {
          "name": "Candidatos por nome",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/vnd.github+json"
              },
              {
                "key": "User-Agent",
                "value": "AmanhecerOSINT/0.2.0"
              },
              {
                "key": "X-GitHub-Api-Version",
                "value": "2026-03-10"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "https://api.github.com/search/users?q=%22{{nome_completo}}%22+in%3Afullname+type%3Auser&per_page={{limite}}&page=1",
              "protocol": "https",
              "host": [
                "api",
                "github",
                "com"
              ],
              "path": [
                "search",
                "users"
              ],
              "query": [
                {
                  "key": "q",
                  "value": "\"{{nome_completo}}\" in:fullname type:user"
                },
                {
                  "key": "per_page",
                  "value": "{{limite}}"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Possíveis perfis, sem confirmação de identidade. Preencha nome_completo. Confira incomplete_results e total_count."
          },
          "response": []
        }
      ]
    },
