              "protocol": "https",
              "host": [
                "gitlab",
                "com"
              ],
              "path": [
                "api",
                "v4",
                "users"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "{{nome_completo}}"
                },
                {
                  "key": "per_page",
                  "value": "{{limite}}"
                },
                {
                  "key": "page",
                  "value": "1"
                }
              ]
            },
            "description": "Busca candidatos; pode corresponder ao nome ou arroba. Não confirma identidade."
          },
          "response": []
        }
      ]
